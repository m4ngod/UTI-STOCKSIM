# 虚拟环境（必加，避免复制环境报错）
venv/
env/
.venv/

# Python 缓存文件
__pycache__/
*.py[cod]
*$py.class

# PyCharm 配置（可选，不想同步 IDE 配置就加上）
.idea/

# 系统临时文件
*.swp
*.swo
.DS_Store

Quent.zip

# Runtime output and local test artifacts
logs/
stock_sim/logs/
stock_sim/artifacts/
stock_sim/output/
stock_sim/tmp/
stock_sim/backups/

# Local package/build/cache output
build/
dist/
*.egg-info/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Local databases and SQLite sidecars
*.db
*.sqlite
*.sqlite3
*.db-shm
*.db-wal

# Ad hoc simulation exports and archives
export_snap-*.csv
stock_sim/export_snap-*.csv
stock_sim.zip

# Local document/rendering tool cache
tools/bin/
tools/downloads/
tools/LibreOffice*/
